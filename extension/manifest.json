{
  "manifest_version": 3,
  "name": "SERM Cookie Sync",
  "version": "1.0.0",
  "description": "Автоматическая передача и синхронизация сессий (VC.ru, Spark.ru, Dzen, E-xecutive) с боевым SERM Engine",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.vc.ru/*",
    "*://*.spark.ru/*",
    "*://*.dzen.ru/*",
    "*://*.e-xecutive.ru/*",
    "*://*.habr.com/*",
    "*://*.rb.ru/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SERM Cookie Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
