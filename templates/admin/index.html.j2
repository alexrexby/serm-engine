        <button class="btn btn-outline btn-sm" onclick="copyModalMarkdown()">📋 Скопировать Markdown</button>
        <button class="btn btn-outline btn-sm" id="btnCopyPitch" onclick="copyModalPitch()" style="display: none;">✉️ Скопировать питч</button>
