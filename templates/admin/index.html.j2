<footer style="text-align: center; font-size: 12px; color: var(--text-muted); padding: 24px 0;">
  SERM Distribution Engine &middot; AGPL-3.0-or-later &middot;
  {% if source_url %}<a href="{{ source_url }}" target="_blank" rel="noopener" style="color: var(--text-muted);">Исходный код</a>{% else %}Исходный код — в каталоге установки{% endif %}
</footer>

<div class="toast" id="toast"></div>

<script>
  const CAMPAIGN_ID = {{ campaign_id|tojson }};
  let cachedNews = [];
  let cachedArticles = [];
  let currentFilter = 'all';
  let activeModalArticle = null;

  // Data from the API (Telegram names, /start arguments, RSS, LLM output) never reaches innerHTML raw:
  // esc() for text and attribute values, safeUrl() for href, jsArg() for arguments of inline handlers.
  function esc(value) {
    return String(value ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  function safeUrl(value) {
    const url = String(value ?? '').trim();
    return /^(https?:\/\/|\/(?!\/))/i.test(url) ? url : '#';
  }

  function jsArg(value) {
    return esc(JSON.stringify(String(value ?? '')));
  }

  // Article HTML preview: parsed in an inert document, only allow-listed tags are copied with `class` (styling) and a safe href
  const PREVIEW_TAGS = new Set(['H1', 'H2', 'H3', 'H4', 'P', 'BR', 'HR', 'STRONG', 'B', 'EM', 'I', 'U', 'S', 'CODE', 'PRE',
    'BLOCKQUOTE', 'UL', 'OL', 'LI', 'A', 'TABLE', 'THEAD', 'TBODY', 'TR', 'TH', 'TD', 'DIV', 'SPAN']);
  const PREVIEW_DROP = new Set(['SCRIPT', 'STYLE', 'TEMPLATE', 'NOSCRIPT', 'IFRAME', 'OBJECT', 'EMBED', 'SVG', 'MATH']);

  function safeHtml(html) {
    const copy = (src, dst) => {
      src.childNodes.forEach(node => {
        if (node.nodeType === Node.TEXT_NODE) {
          dst.appendChild(document.createTextNode(node.textContent));
        } else if (node.nodeType === Node.ELEMENT_NODE && !PREVIEW_DROP.has(node.tagName)) {
          if (!PREVIEW_TAGS.has(node.tagName)) {
            copy(node, dst);
            return;
          }
          const el = document.createElement(node.tagName);
          if (node.hasAttribute('class')) el.className = node.getAttribute('class');
          if (node.tagName === 'A') {
            el.href = safeUrl(node.getAttribute('href'));
            el.target = '_blank';
            el.rel = 'noopener';
          }
          copy(node, el);
          dst.appendChild(el);
        }
      });
    };
    const fragment = document.createDocumentFragment();
    copy(new DOMParser().parseFromString(String(html ?? ''), 'text/html').body, fragment);
    return fragment;
  }

  function showToast(msg) {
    const t = document.getElementById('toast');
    t.innerText = msg;
    t.style.display = 'block';
    setTimeout(() => { t.style.display = 'none'; }, 4500);
  }

  function toggleVisibility(id) {
    const el = document.getElementById(id);
    el.type = el.type === 'password' ? 'text' : 'password';
  }

  function editSecret(id) {
    const el = document.getElementById(id);
    el.disabled = false;
    el.value = '';
    el.focus();
  }

  function lockSecrets() {
    document.querySelectorAll('#secretsForm input[data-secret]').forEach(el => {
      el.value = '';
      el.disabled = true;
    });
  }

  function switchTab(tabId) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    event.currentTarget.classList.add('active');
    document.getElementById('tab-' + tabId).classList.add('active');

    if (tabId === 'articles' && cachedArticles.length === 0) loadArticles();
    if (tabId === 'analytics') loadAnalytics();
    if (tabId === 'horizon' && cachedNews.length === 0) loadHorizonNews();
    if (tabId === 'leadmagnets') loadLeadMagnets();
    if (tabId === 'sessions') loadSessionsStatus();
  }

  function filterArticles(filter) {
    currentFilter = filter;
    document.querySelectorAll('.articles-filters .filter-btn').forEach(b => b.classList.remove('active'));
    event.currentTarget.classList.add('active');
    renderArticlesTable();
  }

  async function loadArticles() {
    const container = document.getElementById('articlesTableContainer');
    container.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--text-muted);">Загрузка статей из базы данных...</div>';
    try {
      const res = await fetch('/api/articles/list?campaign=' + encodeURIComponent(CAMPAIGN_ID));
      if (res.status === 401) {
        window.location.href = '/admin';
        return;
      }
      const data = await res.json();
      cachedArticles = data.articles || [];
      document.getElementById('articlesCountBadge').innerText = cachedArticles.length + ' статей';
      renderArticlesTable();
    } catch (e) {
      container.innerHTML = '<div style="color: var(--danger); padding: 20px;">Ошибка загрузки статей: ' + esc(e) + '</div>';
    }
  }

  function renderArticlesTable() {
    const container = document.getElementById('articlesTableContainer');
    if (!cachedArticles || cachedArticles.length === 0) {
      container.innerHTML = '<div style="text-align: center; padding: 30px;">Нет статей в кампании.</div>';
      return;
    }

    let filtered = cachedArticles.filter(a => {
      if (currentFilter === 'all') return true;
      if (currentFilter === 'ugc') return ['vc', 'spark', 'dzen', 'executive'].includes(a.platform);
      if (currentFilter === 'editorial') return ['tbank', 'biz360', 'rb'].includes(a.platform);
      if (currentFilter === 'ready') return a.status === 'ready';
      if (currentFilter === 'published') return a.status === 'published';
      return true;
    });

    if (filtered.length === 0) {
      container.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--text-muted);">Нет статей, соответствующих фильтру.</div>';
      return;
    }

    let html = `
      <table class="articles-table">
        <thead>
          <tr>
            <th style="width: 130px;">Площадка</th>
            <th>Заголовок и ключевые тезисы</th>
            <th style="width: 140px;">Лид-магнит</th>
            <th style="width: 140px;">Статус</th>
            <th style="width: 220px; text-align: right;">Действия</th>
          </tr>
        </thead>
        <tbody>
    `;

    filtered.forEach((a, idx) => {
      const isUGC = ['vc', 'spark', 'dzen', 'executive'].includes(a.platform);
      const platClass = 'plat-' + a.platform;
      const platName = a.platform_name || a.platform.toUpperCase();
      const typeLabel = isUGC ? 'UGC' : 'Редакция';
      const typeBadgeClass = isUGC ? 'type-ugc' : 'type-editorial';

      let statusBadge = '';
      if (a.status === 'published') {
        statusBadge = '<span class="status-tag status-published">🟢 Опубликовано</span>';
      } else if (a.status === 'draft') {
        statusBadge = '<span class="status-tag status-ready">📝 Черновик</span>';
      } else if (a.status === 'failed') {
        statusBadge = '<span class="status-tag status-failed" title="' + esc(a.error_message) + '">🔴 Ошибка</span>';
      } else {
        statusBadge = '<span class="status-tag status-ready">⚪️ Готова к публикации</span>';
      }

      let actionsHtml = '';
      if (isUGC) {
        if (a.status === 'published' && a.published_url) {
          actionsHtml = `
            <a href="${esc(safeUrl(a.published_url))}" target="_blank" class="btn btn-sm btn-outline" style="text-decoration:none;">🔗 Читать</a>
            <button class="btn btn-sm btn-warning" onclick="triggerFastIndexForUrl(${jsArg(a.published_url)}, ${jsArg(encodeURIComponent(a.title))})">⚡️ Пинг</button>
            <button class="btn btn-sm btn-outline" onclick="openArticleModal(${jsArg(a.id)})">👁 Текст</button>
          `;
        } else {
          actionsHtml = `
            <button class="btn btn-sm btn-outline" onclick="openArticleModal(${jsArg(a.id)})">👁 Текст</button>
            <button class="btn btn-sm btn-success" id="btnPub_${esc(a.id)}" onclick="publishArticle(${jsArg(a.id)}, ${jsArg(a.platform)})">🚀 Опубликовать</button>
          `;
        }
      } else {
        // Editorial
        const formLink = a.platform === 'tbank' ? 'https://t.me/bs_community_bot' :
                         a.platform === 'biz360' ? 'https://biz360.ru/about/feedback/' :
                         'https://rb.ru/opinion/';
        actionsHtml = `
          <button class="btn btn-sm btn-outline" onclick="openArticleModal(${jsArg(a.id)})">👁 Питч &amp; Текст</button>
          <a href="${formLink}" target="_blank" class="btn btn-sm btn-outline" style="text-decoration:none;" title="Открыть канал/форму подачи материала">✉️ Подать ↗</a>
        `;
      }

      if (a.status === 'draft') {
        actionsHtml = `
          <button class="btn btn-sm btn-outline" onclick="openArticleModal(${jsArg(a.id)})">👁 Текст</button>
          <button class="btn btn-sm btn-success" id="btnApprove_${esc(a.id)}" onclick="approveArticle(${jsArg(a.id)})">✅ Одобрить</button>
        `;
      }

      const publishedLink = a.published_url ? `
        <div style="margin-top: 4px; font-size: 11px;">
          <a href="${esc(safeUrl(a.published_url))}" target="_blank" style="color: #38bdf8; text-decoration: none;">🔗 ${esc(a.published_url)}</a>
        </div>
      ` : '';

      html += `
        <tr>
          <td>
            <div class="plat-pill ${esc(platClass)}">${esc(platName)}</div>
            <div style="margin-top: 5px;">
              <span class="type-tag ${typeBadgeClass}">${typeLabel}</span>
            </div>
          </td>
          <td>
            <div style="font-weight: 600; font-size: 13.5px; color: #f1f5f9; margin-bottom: 4px;">${esc(a.title)}</div>
            <div style="font-size: 11.5px; color: var(--text-muted); line-height: 1.4;">${esc((a.lead || '').slice(0, 140))}...</div>
            ${publishedLink}
          </td>
          <td>
            <div style="font-size: 11.5px; font-weight: 600; color: #94a3b8;">📄 В конце статьи</div>
            <div style="font-size: 11px; color: var(--text-muted);">Блок «Что дальше»</div>
          </td>
          <td>
            ${statusBadge}
          </td>
          <td style="text-align: right;">
            <div style="display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap;">
              ${actionsHtml}
            </div>
          </td>
        </tr>
      `;
    });

    html += '</tbody></table>';
    container.innerHTML = html;
  }

  async function openArticleModal(articleId) {
    showToast('Загрузка текста статьи...');
    try {
      const res = await fetch('/api/articles/content?id=' + articleId);
      const data = await res.json();
      if (!data.success) {
        showToast('❌ Ошибка: ' + (data.error || 'Статья не найдена'));
        return;
      }
      activeModalArticle = data.article;
      const art = data.article;

      const isUGC = ['vc', 'spark', 'dzen', 'executive'].includes(art.platform);
      const platBadge = document.getElementById('modalPlatformBadge');
      platBadge.className = 'plat-pill plat-' + art.platform;
      platBadge.innerText = art.platform_name || art.platform.toUpperCase();

      const typeBadge = document.getElementById('modalTypeBadge');
      typeBadge.className = 'type-tag ' + (isUGC ? 'type-ugc' : 'type-editorial');
      typeBadge.innerText = isUGC ? 'UGC' : 'Редакция';

      const statusBadge = document.getElementById('modalStatusBadge');
      statusBadge.className = 'status-tag ' + (art.status === 'published' ? 'status-published' : 'status-ready');
      statusBadge.innerText = art.status === 'published' ? '🟢 Опубликовано' : '⚪️ Готова к публикации';

      document.getElementById('modalArticleTitle').innerText = art.title;
      document.getElementById('modalMarkdownContent').value = art.content_markdown;
      const previewBox = document.getElementById('modalHtmlPreviewBox');
      if (art.content_html) previewBox.replaceChildren(safeHtml(art.content_html));
      else previewBox.innerHTML = '<p style="color:#ef4444;">HTML вёрстка не сформирована</p>';
      switchModalTab('preview');
      
      const words = (art.content_markdown || '').split(/\s+/).filter(Boolean).length;
      const chars = (art.content_markdown || '').length;
      document.getElementById('modalMetaInfo').innerText = 'Слов: ' + words + ' | Символов: ' + chars + ' | Время чтения: ~' + Math.ceil(words / 180) + ' мин';

      // Pitch block for editorial
      const pitchBlock = document.getElementById('modalPitchBlock');
      const btnCopyPitch = document.getElementById('btnCopyPitch');
      if (data.pitch_text) {
        pitchBlock.style.display = 'block';
        document.getElementById('modalPitchText').innerText = data.pitch_text;
        btnCopyPitch.style.display = 'inline-block';
      } else {
        pitchBlock.style.display = 'none';
        btnCopyPitch.style.display = 'none';
      }

      // Modal action button
      const actEl = document.getElementById('modalPublishAction');
      if (isUGC) {
        if (art.status === 'published' && art.published_url) {
          actEl.innerHTML = `
            <a href="${esc(safeUrl(art.published_url))}" target="_blank" class="btn btn-outline btn-sm">🔗 Открыть на ${esc(platBadge.innerText)} ↗</a>
          `;
        } else if (art.status === 'draft') {
          actEl.innerHTML = `
            <button class="btn btn-success btn-sm" onclick="approveArticle(${jsArg(art.id)}); closeArticleModal();">✅ Одобрить к публикации</button>
          `;
        } else {
          actEl.innerHTML = `
            <button class="btn btn-success btn-sm" onclick="publishArticle(${jsArg(art.id)}, ${jsArg(art.platform)}); closeArticleModal();">🚀 Опубликовать на ${esc(platBadge.innerText)}</button>
          `;
        }
      } else {
        const link = art.platform === 'tbank' ? 'https://t.me/bs_community_bot' :
                     art.platform === 'biz360' ? 'https://biz360.ru/about/feedback/' :
                     'https://rb.ru/opinion/';
        actEl.innerHTML = `
          <a href="${link}" target="_blank" class="btn btn-primary btn-sm">✉️ Открыть канал подачи материала ↗</a>
        `;
      }

      document.getElementById('articleModal').style.display = 'flex';
    } catch (e) {
      showToast('❌ Ошибка загрузки статьи');
    }
  }

  function closeArticleModal() {
    document.getElementById('articleModal').style.display = 'none';
    activeModalArticle = null;
  }

  function closeArticleModalOnBackdrop(e) {
    if (e.target.id === 'articleModal') {
      closeArticleModal();
    }
  }

  function switchModalTab(tab) {
    const btnPrev = document.getElementById('tabBtnPreview');
    const btnMd = document.getElementById('tabBtnMarkdown');
    const viewPrev = document.getElementById('modalViewPreview');
    const viewMd = document.getElementById('modalViewMarkdown');

    if (tab === 'preview') {
      btnPrev.classList.add('active');
      btnMd.classList.remove('active');
      viewPrev.style.display = 'block';
      viewMd.style.display = 'none';
    } else {
      btnMd.classList.add('active');
      btnPrev.classList.remove('active');
      viewMd.style.display = 'block';
      viewPrev.style.display = 'none';
    }
  }

  function copyModalHtml() {
    if (!activeModalArticle) return;
    const html = activeModalArticle.content_html || document.getElementById('modalHtmlPreviewBox').innerHTML;
    navigator.clipboard.writeText(html);
    showToast('✅ Полный HTML код статьи скопирован в буфер!');
  }

  function copyModalMarkdown() {
    if (!activeModalArticle) return;
    navigator.clipboard.writeText(activeModalArticle.content_markdown);
    showToast('✅ Полный текст Markdown скопирован в буфер!');
  }

  function copyModalPitch() {
    const text = document.getElementById('modalPitchText').innerText;
    if (!text) return;
    navigator.clipboard.writeText(text);
    showToast('✅ Питч для редакции скопирован в буфер!');
  }

  async function publishArticle(articleId, platform) {
    const btn = document.getElementById('btnPub_' + articleId);
    if (btn) {
      btn.disabled = true;
      btn.innerText = '⏳ Публикация...';
    }
    showToast('🚀 Публикуем на ' + platform.toUpperCase() + '…');

    try {
      const res = await fetch('/api/publish/article', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ article_id: articleId })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Успешно опубликовано на ' + platform.toUpperCase() + '! ' + (data.published_url || ''));
        loadArticles();
      } else {
        showToast('❌ Ошибка публикации (' + platform + '): ' + (data.error || data.message));
        if (btn) {
          btn.disabled = false;
          btn.innerText = '🚀 Повторить';
        }
      }
    } catch (e) {
      showToast('❌ Ошибка сети при публикации: ' + e);
      if (btn) {
        btn.disabled = false;
        btn.innerText = '🚀 Опубликовать';
      }
    }
  }

  async function approveArticle(articleId) {
    const btn = document.getElementById('btnApprove_' + articleId);
    if (btn) btn.disabled = true;
    try {
      const res = await fetch('/api/articles/approve', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ article_id: articleId })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Статья одобрена и готова к публикации');
        loadArticles();
      } else {
        showToast('❌ ' + (data.error || 'Не удалось одобрить статью'));
        if (btn) btn.disabled = false;
      }
    } catch (e) {
      showToast('❌ Ошибка сети: ' + e);
      if (btn) btn.disabled = false;
    }
  }

  async function publishAllUGC() {
    const btn = document.getElementById('btnPublishAllUgc');
    btn.disabled = true;
    btn.innerText = '⏳ Публикация UGC пакета...';
    showToast('🚀 Запуск очереди публикации на VC.ru, Spark, Дзен, E-xecutive...');

    try {
      const res = await fetch('/api/publish/campaign', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ campaign_id: CAMPAIGN_ID, fast_index: true })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Пакетная публикация завершена! Результаты обновлены.');
      } else {
        showToast('⚠️ Публикация завершилась с замечаниями: ' + (data.error || 'см. таблицу'));
      }
      loadArticles();
    } catch (e) {
      showToast('❌ Ошибка пакетной публикации: ' + e);
    } finally {
      btn.disabled = false;
      btn.innerText = '🚀 Опубликовать все UGC';
    }
  }

  async function triggerFastIndexForUrl(url, titleEnc) {
    const title = decodeURIComponent(titleEnc);
    showToast('⚡️ Отправляем ссылку на быструю индексацию (Telegram, VK, IndexNow)…');
    try {
      const res = await fetch('/api/fast-index/ping', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url, title })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Ссылка отправлена на быструю индексацию');
      } else {
        showToast('⚠️ Fast-Index: ' + (data.message || 'Ошибки доставки'));
      }
    } catch (e) {
      showToast('❌ Ошибка отправки Fast-Index: ' + e);
    }
  }

  function triggerFastIndexManual() {
    const url = prompt('Ссылка на статью для быстрой индексации (Telegram, VK, IndexNow):');
    if (!url) return;
    const title = prompt('Заголовок материала (необязательно):', {{ fast_index_title|tojson }}) || 'Новый материал';
    triggerFastIndexForUrl(url, encodeURIComponent(title));
  }

  function onPresetChange() {
    const val = document.getElementById('lmPreset').value;
    document.getElementById('customTopicGroup').style.display = (val === 'custom') ? 'block' : 'none';
  }

  async function logout() {
    await fetch('/api/logout', { method: 'POST' });
    window.location.href = '/admin';
  }

  async function reloadStatus() {
    try {
      const res = await fetch('/api/status');
      if (res.status === 401) {
        window.location.href = '/admin';
        return;
      }
      const data = await res.json();
      const bStatus = document.getElementById('botStatus');
      if (data.bot_online) {
        bStatus.innerHTML = '<span class="dot dot-green"></span> Онлайн (@' + esc(data.bot_username) + ')';
      } else if (data.has_token) {
        bStatus.innerHTML = '<span class="dot dot-yellow"></span> Ошибка запуска бота';
      } else {
        bStatus.innerHTML = '<span class="dot dot-yellow"></span> Токен не задан';
      }

      document.getElementById('channelStatus').innerText = data.opp_channel || {{ channel|tojson }};
      if (data.opp_bot_token) document.getElementById('oppBotToken').placeholder = 'Задан: ' + data.opp_bot_token;
      if (data.opp_channel) document.getElementById('oppChannel').value = data.opp_channel;
      if (data.opp_contact) document.getElementById('oppContact').value = data.opp_contact;
      if (data.serm_tg_token) document.getElementById('sermTgToken').placeholder = 'Задан: ' + data.serm_tg_token;
      if (data.serm_tg_channel) document.getElementById('sermTgChannel').value = data.serm_tg_channel;
      if (data.serm_vk_token) document.getElementById('sermVkToken').placeholder = 'Задан: ' + data.serm_vk_token;
    } catch (e) {
      console.error(e);
    }
  }

  async function loadHorizonNews(refresh = false) {
    const listEl = document.getElementById('horizonList');
    listEl.innerHTML = '<div style="text-align: center; padding: 30px; color: var(--text-muted);">Сбор свежих инфоповодов...</div>';
    try {
      const url = '/api/horizon/news' + (refresh ? '?refresh=1' : '');
      const res = await fetch(url);
      const data = await res.json();
      cachedNews = data.news || [];
      document.getElementById('horizonCount').innerHTML = '<span class="dot dot-green"></span> ' + cachedNews.length + ' инфоповодов';

      if (cachedNews.length === 0) {
        listEl.innerHTML = '<div style="text-align: center; padding: 20px;">Нет свежих новостей. Нажмите «Обновить источники».</div>';
        return;
      }

      let html = '';
      cachedNews.forEach((item, idx) => {
        const isHigh = (item.business_score || 5) >= 7.0;
        const scoreClass = isHigh ? 'score-high' : '';
        const title = item.applied_title ? `⚡️ [Разбор] ${esc(item.applied_title)}` : esc(item.title);
        const rawHook = item.applied_title ? `<div style="font-size: 11.5px; color: var(--text-muted); margin-bottom: 8px;">Триггер рынка: <em>«${esc(item.title)}»</em></div>` : '';
        
        const holeBox = item.business_hole ? `
          <div class="meat-point">💥 <strong>Проблема бизнеса:</strong> ${esc(item.business_hole)}</div>
        ` : '';
        
        const solutionBox = item.vibecode_solution ? `
          <div class="meat-point">🛠 <strong>Решение:</strong> ${esc(item.vibecode_solution)}</div>
        ` : '';

        const impactBox = item.financial_impact ? `
          <div class="meat-point">💰 <strong>Экономический эффект:</strong> <span class="highlight-green">${esc(item.financial_impact)}</span></div>
        ` : '';

        const promptBox = item.cursor_prompt ? `
          <div style="margin-top: 10px;">
            <div style="font-size: 11px; font-weight: 700; color: #38bdf8; text-transform: uppercase;">📋 Готовый промпт:</div>
            <pre class="prompt-box" id="prompt_${idx}">${esc(item.cursor_prompt)}</pre>
          </div>
        ` : '';

        html += `
          <div class="news-card">
            <div class="news-header">
              <span class="news-source">📌 ${esc(item.source_name)} | ${esc(item.published_at || 'Сегодня')}</span>
              <span class="score-badge ${scoreClass}">⚡ Значимость для бизнеса: ${esc(item.business_score || 9)}/10</span>
            </div>
            <div class="news-title" style="font-size: 15px; margin-bottom: 4px;">${title}</div>
            ${rawHook}
            <div class="vibecode-box">
              ${holeBox}
              ${solutionBox}
              ${impactBox}
              ${promptBox}
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              ${item.cursor_prompt ? `<button class="btn btn-sm btn-outline" onclick="copyCursorPrompt(${idx})">📋 Скопировать промпт</button>` : ''}
              <button class="btn btn-sm btn-success" onclick="synthesizeNews(${idx})">🚀 Сделать статьи и лид-магнит по этой новости</button>
              ${item.link ? `<a href="${esc(safeUrl(item.link))}" target="_blank" class="btn btn-sm btn-outline" style="text-decoration:none;">Оригинал ↗</a>` : ''}
            </div>
          </div>
        `;
      });
      listEl.innerHTML = html;
    } catch (e) {
      listEl.innerHTML = '<div style="color: var(--danger); padding: 20px;">Не удалось загрузить инфоповоды: ' + esc(e) + '</div>';
    }
  }

  function copyCursorPrompt(idx) {
    const item = cachedNews[idx];
    if (!item || !item.cursor_prompt) return;
    navigator.clipboard.writeText(item.cursor_prompt);
    showToast('✅ Промпт скопирован');
  }

  async function synthesizeNews(idx) {
    const item = cachedNews[idx];
    if (!item) return;
    showToast('Готовим статьи и лид-магнит по новости: ' + item.title.slice(0, 30) + '...');
    try {
      const res = await fetch('/api/horizon/synthesize', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ news_item: item })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Кампания создана: статьи и лид-магнит готовы (' + data.result.lead_magnet_preset + ')');
        loadLeadMagnets();
      } else {
        showToast('❌ Не удалось создать кампанию: ' + data.error);
      }
    } catch (e) {
      showToast('❌ Ошибка соединения');
    }
  }

  async function loadLeadMagnets() {
    const listEl = document.getElementById('lmLibraryList');
    try {
      const res = await fetch('/api/lead-magnet/list');
      const data = await res.json();
      const magnets = data.magnets || [];
      if (magnets.length === 0) {
        listEl.innerHTML = '<div style="text-align: center; padding: 20px;">Файлов пока нет. Создайте первый лид-магнит выше.</div>';
        return;
      }
      let html = '';
      magnets.forEach(m => {
        html += `
          <div class="lm-item">
            <div>
              <div style="font-weight: 700; font-size: 13.5px; margin-bottom: 3px;">📄 ${esc(m.name)}</div>
              <div style="font-size: 11.5px; color: var(--text-muted);">${esc(m.filename)} • ${esc(m.size_kb)} KB</div>
            </div>
            <div style="display: flex; gap: 8px;">
              <a class="btn btn-sm btn-outline" href="${esc(safeUrl(m.url))}" download>📥 Скачать PDF</a>
            </div>
          </div>
        `;
      });
      listEl.innerHTML = html;
    } catch (e) {
      console.error(e);
    }
  }

  document.getElementById('lmGenForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const preset = document.getElementById('lmPreset').value;
    const custom = document.getElementById('lmCustomTopic').value.trim();
    const topic = (preset === 'custom') ? custom : preset;

    if (preset === 'custom' && !custom) {
      showToast('⚠️ Введите название темы для лид-магнита');
      return;
    }

    const btn = document.getElementById('genLmBtn');
    btn.disabled = true;
    btn.innerText = '⏳ Собираем PDF…';
    showToast('Генерация лид-магнита (Markdown + PDF)...');

    try {
      const res = await fetch('/api/lead-magnet/generate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ topic })
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Лид-магнит готов: ' + data.title.slice(0, 35) + '... (' + data.size_kb + ' KB)');
        loadLeadMagnets();
      } else {
        showToast('❌ Ошибка генерации: ' + data.error);
      }
    } catch (e) {
      showToast('❌ Ошибка сети при генерации');
    } finally {
      btn.disabled = false;
      btn.innerText = '🚀 Создать PDF и Markdown';
    }
  });

  async function loadSessionsStatus() {
    try {
      const res = await fetch('/api/sessions/status');
      const data = await res.json();
      const plats = data.platforms || {};

      ['vc', 'spark', 'dzen', 'executive'].forEach(p => {
        const badge = document.getElementById(p + 'StatusBadge');
        if (plats[p] && plats[p].has_cookies) {
          badge.className = 'score-badge score-high';
          badge.innerText = '🟢 Сессия сохранена';
        } else {
          badge.className = 'score-badge';
          badge.innerText = '🔴 Требуются куки';
        }
      });
    } catch (e) {
      console.error(e);
    }
  }

  async function saveSession(platform) {
    const input = document.getElementById(platform + 'Cookies');
    const cookies = input.value.trim();
    if (!cookies) {
      showToast('⚠️ Вставьте куки перед сохранением');
      return;
    }
    showToast('Проверяем вход на ' + platform.toUpperCase() + '...');
    try {
      const res = await fetch('/api/sessions/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ platform, cookies })
      });
      const data = await res.json();
      if (data.authorized) {
        showToast('✅ ' + data.message);
        loadSessionsStatus();
      } else {
        showToast('⚠️ Статус: ' + (data.message || 'Ошибка валидации'));
      }
    } catch (e) {
      showToast('❌ Ошибка сохранения сессии');
    }
  }

  async function verifyBotToken() {
    const tokenInput = document.getElementById('oppBotToken');
    const token = tokenInput.value.trim();
    if (!token && !tokenInput.disabled) {
      showToast('⚠️ Введите токен бота перед проверкой');
      return;
    }
    showToast('Проверка токена в Telegram API...');
    try {
      const res = await fetch('/api/check-bot', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });
      const data = await res.json();
      if (data.ok) {
        showToast('✅ Токен рабочий. Бот: @' + data.result.username + ' (' + data.result.first_name + ')');
      } else {
        showToast('❌ Ошибка токена: ' + (data.description || 'Неверный токен'));
      }
    } catch (e) {
      showToast('❌ Ошибка сети при проверке токена');
    }
  }

  document.getElementById('secretsForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target);
    const payload = Object.fromEntries(formData.entries());
    // A secret is applied by the server only with its explicit change flag
    e.target.querySelectorAll('input[data-secret]').forEach(el => {
      if (!el.disabled && el.value.trim()) payload['__set__' + el.name] = '1';
    });

    showToast('Сохраняем и перезапускаем бота…');
    try {
      const res = await fetch('/api/secrets', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        showToast('✅ Сохранено, бот перезапущен');
        lockSecrets();
        setTimeout(reloadStatus, 1500);
      } else {
        showToast('❌ Ошибка: ' + (data.error || 'Ошибка сохранения'));
      }
    } catch (e) {
      showToast('❌ Ошибка сохранения');
    }
  });

  // --- CONVERSION & CONTENT ANALYTICS ---
  let cachedAnalytics = null;

  async function loadAnalytics() {
    const timeEl = document.getElementById('analyticsLastUpdated');
    if (timeEl) timeEl.innerText = 'Загрузка...';

    try {
      const res = await fetch('/api/analytics');
      if (res.status === 401) {
        window.location.href = '/admin';
        return;
      }
      const data = await res.json();
      if (!data.success) {
        if (timeEl) timeEl.innerText = 'Ошибка загрузки';
        return;
      }
      cachedAnalytics = data;
      renderAnalytics(data);
      if (timeEl) {
        const now = new Date();
        timeEl.innerText = 'Обновлено в ' + now.toLocaleTimeString();
      }
    } catch (e) {
      if (timeEl) timeEl.innerText = 'Сбой сети';
    }
  }

  function renderAnalytics(data) {
    const s = data.summary || {};
    const starts = s.unique_starts || 0;
    const subs = s.unique_subscribers || 0;
    const pdfs = s.unique_pdfs || 0;
    const leads = s.unique_leads || 0;

    document.getElementById('kpiStarts').innerText = starts;
    document.getElementById('kpiSubs').innerText = subs;
    document.getElementById('kpiPdfs').innerText = pdfs;
    document.getElementById('kpiLeads').innerText = leads;

    document.getElementById('badgeCrSub').innerText = 'CR: ' + (s.cr_sub || 0) + '%';
    document.getElementById('badgeCrPdf').innerText = 'CR: ' + (s.cr_pdf || 0) + '%';
    document.getElementById('badgeCrLead').innerText = 'CR: ' + (s.cr_lead || 0) + '%';

    // Render Sample Size Card
    const sampleProgress = s.sample_progress || 0;
    const sampleStatus = s.sample_status || ('Калибровка (' + starts + '/50 мин.)');
    const sampleDesc = s.sample_description || 'Решения принимаются по объёму выборки (50–100 переходов), а не по календарным датам.';
    const sampleColor = s.sample_color || '#f59e0b';

    const countEl = document.getElementById('sampleCountDisplay');
    if (countEl) countEl.innerText = starts;

    const barEl = document.getElementById('sampleProgressBar');
    if (barEl) barEl.style.width = Math.min(100, sampleProgress) + '%';

    const badgeEl = document.getElementById('sampleStatusBadge');
    if (badgeEl) {
      badgeEl.innerText = sampleStatus;
      badgeEl.style.color = sampleColor;
      badgeEl.style.background = sampleColor === '#10b981' ? 'rgba(16, 185, 129, 0.2)' : 
                                 (sampleColor === '#3b82f6' ? 'rgba(59, 130, 246, 0.2)' : 'rgba(245, 158, 11, 0.2)');
    }

    const descEl = document.getElementById('sampleDescText');
    if (descEl) descEl.innerText = sampleDesc;

    // Render Funnel Visual
    const funnelContainer = document.getElementById('funnelVisualContainer');

    const pctSubs = starts > 0 ? Math.round((subs / starts) * 100) : 0;
    const pctPdfs = starts > 0 ? Math.round((pdfs / starts) * 100) : 0;
    const pctLeads = starts > 0 ? Math.round((leads / starts) * 100) : 0;

    funnelContainer.innerHTML = `
      <div style="display: flex; flex-direction: column; gap: 14px;">
        <div>
          <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 5px;">
            <span style="font-weight: 600;">1. Клик по ссылке из поста / статьи</span>
            <strong>${esc(starts)} чел. (100%)</strong>
          </div>
          <div style="height: 10px; background: #1e293b; border-radius: 5px; overflow: hidden;">
            <div style="height: 100%; width: 100%; background: #38bdf8; border-radius: 5px;"></div>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 5px;">
            <span style="font-weight: 600;">2. Подписка на канал {{ channel }}</span>
            <strong>${esc(subs)} чел. (${pctSubs}%)</strong>
          </div>
          <div style="height: 10px; background: #1e293b; border-radius: 5px; overflow: hidden;">
            <div style="height: 100%; width: ${pctSubs}%; background: #10b981; border-radius: 5px; transition: width 0.5s;"></div>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 5px;">
            <span style="font-weight: 600;">3. Получили материал</span>
            <strong>${esc(pdfs)} чел. (${pctPdfs}%)</strong>
          </div>
          <div style="height: 10px; background: #1e293b; border-radius: 5px; overflow: hidden;">
            <div style="height: 100%; width: ${pctPdfs}%; background: #818cf8; border-radius: 5px; transition: width 0.5s;"></div>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 5px;">
            <span style="font-weight: 600;">4. Коммерческое обращение</span>
            <strong>${esc(leads)} чел. (${pctLeads}%)</strong>
          </div>
          <div style="height: 10px; background: #1e293b; border-radius: 5px; overflow: hidden;">
            <div style="height: 100%; width: ${pctLeads}%; background: #f59e0b; border-radius: 5px; transition: width 0.5s;"></div>
          </div>
        </div>
      </div>
    `;

    // Render Strategy Recommendations
    const recsContainer = document.getElementById('strategyRecsContainer');
    const recs = data.recommendations || [];
    if (recs.length === 0) {
      recsContainer.innerHTML = '<div style="color: var(--text-muted); font-size: 13px;">Данных пока мало: нужны переходы по ссылкам на бота.</div>';
    } else {
      recsContainer.innerHTML = recs.map(r => {
        const borderCol = r.priority === 'high' ? '#38bdf8' : '#64748b';
        const icon = r.priority === 'high' ? '🎯' : '💡';
        return `
          <div style="background: rgba(18, 26, 45, 0.85); border-left: 3px solid ${borderCol}; padding: 12px 14px; margin-bottom: 10px; border-radius: 4px;">
            <div style="font-weight: 700; font-size: 13.5px; color: #f8fafc; margin-bottom: 4px;">${icon} ${esc(r.title)}</div>
            <div style="font-size: 12.5px; color: #cbd5e1; line-height: 1.45;">${esc(r.text)}</div>
          </div>
        `;
      }).join('');
    }

    // Render Topic Breakdown
    const tbody = document.getElementById('topicBreakdownTbody');
    const breakdown = data.breakdown || [];
    if (breakdown.length === 0) {
      tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 20px; color: var(--text-muted);">Переходов по темам пока не зафиксировано</td></tr>';
    } else {
      tbody.innerHTML = breakdown.map(b => {
        let badge = '';
        if (b.efficiency === 'high') {
          badge = '<span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981;">🔥 Лидер</span>';
        } else if (b.efficiency === 'medium') {
          badge = '<span class="badge" style="background: rgba(56, 189, 248, 0.2); color: #38bdf8;">⚡️ Средняя</span>';
        } else {
          badge = '<span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b;">⚠️ Доработка</span>';
        }

        return `
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.05);">
            <td style="padding: 10px;">
              <div style="font-weight: 600; color: #f1f5f9;">${esc(b.topic_name)}</div>
              <div style="font-size: 11px; color: var(--text-muted); font-family: monospace;">start=${esc(b.slug)}</div>
            </td>
            <td style="padding: 10px; text-align: center; font-weight: 700;">${esc(b.starts)}</td>
            <td style="padding: 10px; text-align: center; color: #10b981;">${esc(b.subs)}</td>
            <td style="padding: 10px; text-align: center; font-weight: 600;">${esc(b.cr_sub)}%</td>
            <td style="padding: 10px; text-align: center; color: #818cf8;">${esc(b.pdfs)}</td>
            <td style="padding: 10px; text-align: center; color: #f59e0b; font-weight: 700;">${esc(b.leads)}</td>
            <td style="padding: 10px; text-align: center; font-weight: 600;">${esc(b.cr_lead)}%</td>
            <td style="padding: 10px; text-align: right;">${badge}</td>
          </tr>
        `;
      }).join('');
    }

    // Render Recent Events
    const eventsTbody = document.getElementById('liveEventsTbody');
    const events = data.recent_events || [];
    document.getElementById('eventsCountBadge').innerText = events.length + ' событий';
    if (events.length === 0) {
      eventsTbody.innerHTML = '<tr><td colspan="5" style="text-align: center; padding: 20px; color: var(--text-muted);">Событий пока нет. Они появятся, когда люди начнут переходить в бота.</td></tr>';
    } else {
      eventsTbody.innerHTML = events.map(ev => {
        let evBadge = '';
        if (ev.event_type === 'start') {
          evBadge = '<span class="badge" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8;">Вход /start</span>';
        } else if (ev.event_type === 'subscribed') {
          evBadge = '<span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #10b981;">Подписка</span>';
        } else if (ev.event_type === 'pdf_delivered') {
          evBadge = '<span class="badge" style="background: rgba(129, 140, 248, 0.2); color: #818cf8;">Выдан PDF</span>';
        } else if (ev.event_type === 'tier_click') {
          evBadge = '<span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #f59e0b;">Заявка</span>';
        } else {
          evBadge = '<span class="badge" style="background: rgba(100, 116, 139, 0.2); color: #94a3b8;">' + esc(ev.event_type) + '</span>';
        }

        const userDisplay = ev.username ? '@' + ev.username : (ev.first_name || 'ID: ' + ev.user_id);
        const timeFormatted = ev.created_at ? ev.created_at.replace('T', ' ').slice(0, 19) : '';

        return `
          <tr style="border-bottom: 1px solid rgba(255,255,255,0.03);">
            <td style="padding: 8px 10px; color: var(--text-muted); font-size: 11.5px; white-space: nowrap;">${esc(timeFormatted)}</td>
            <td style="padding: 8px 10px; font-weight: 600; color: #f1f5f9;">${esc(userDisplay)}</td>
            <td style="padding: 8px 10px;">${evBadge}</td>
            <td style="padding: 8px 10px; font-family: monospace; font-size: 11.5px; color: #38bdf8;">${esc(ev.slug || 'general')}</td>
            <td style="padding: 8px 10px; color: var(--text-muted); font-size: 11.5px;">${esc(ev.details)}</td>
          </tr>
        `;
      }).join('');
    }
  }

  // Initial status load
  reloadStatus();
  loadArticles();
</script>

</body>
</html>
