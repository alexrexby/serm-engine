              <th style="padding: 8px 10px;">Действие</th>
              <th style="padding: 8px 10px;">Тема / Источник</th>
              <th style="padding: 8px 10px;">Детали</th>
            </tr>
          </thead>
          <tbody id="liveEventsTbody">
