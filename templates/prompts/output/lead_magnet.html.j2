{#- Llm-written checklist → HTML source of lead_magnet_<slug>.pdf. Same context as lead_magnet.md.j2.
    Model text is untrusted: everything is escaped here (this path has no autoescape by default). -#}
{%- autoescape true -%}
<!DOCTYPE html>
<html lang="{{ profile.generation.language }}">
<head>
<meta charset="utf-8">
<title>{{ draft.title }}</title>
<style>
  body { font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif; color: #1d2433; margin: 0; padding: 28px 34px; font-size: 13px; line-height: 1.5; }
  h1 { font-size: 24px; margin: 0 0 8px; }
  .desc { color: #556; margin: 0 0 20px; }
  h2 { font-size: 16px; margin: 22px 0 8px; border-bottom: 1px solid #e3e7ef; padding-bottom: 4px; }
  ul.check { list-style: none; padding: 0; margin: 0; }
  ul.check li { padding: 4px 0 4px 26px; position: relative; }
  ul.check li::before { content: ""; position: absolute; left: 0; top: 7px; width: 13px; height: 13px; border: 1.5px solid #8892a6; border-radius: 3px; }
  .offer { margin-top: 28px; padding-top: 12px; border-top: 2px solid #1d2433; }
  .offer a { color: #2457d6; }
</style>
</head>
<body>
<h1>{{ draft.title }}</h1>
{% if magnet.desc %}<p class="desc">{{ magnet.desc }}</p>{% endif %}
{% for section in draft.sections %}
<h2>{{ loop.index }}. {{ section.heading }}</h2>
<ul class="check">
{% for item in section["items"] %}<li>{{ item }}</li>
{% endfor %}</ul>
{% endfor %}
<div class="offer">
{% include "partials/offer.html.j2" %}
</div>
</body>
</html>
{% endautoescape -%}
