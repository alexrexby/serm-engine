# SERM Distribution Engine configuration.
# Copy to .env and fill in. Process environment overrides values from .env.
# Generated from config/settings.py: python -m cli env-example > .env.example
# SERM_ENV_FILE (process environment only, not this file): path to another env file; default .env
# in the project root.

# Telegram bot token from @BotFather (lead-magnet bot)
# aliases: SERM_TG_BOT_TOKEN
OPP_BOT_TOKEN=

# Channel users must subscribe to: @name or -100... id
OPP_CHANNEL=

# Contact for inquiries: @username
OPP_CONTACT=

# Campaign id whose lead magnet the bot serves
SERM_ACTIVE_CAMPAIGN=

# Bot token for posting to the indexing channel
SERM_TG_BOT_TOKEN=

# Public channel for fast indexing: @name
SERM_TG_CHANNEL_ID=

# VK API access token for wall posts
SERM_VK_TOKEN=

# VK user or group id (group: -123456)
SERM_VK_OWNER_ID=

# LLM provider API key
# aliases: LLM_API_KEY
POLZA_API_KEY=

# OpenAI-compatible API base URL
# aliases: LLM_BASE_URL
POLZA_BASE_URL=https://api.polza.ai/v1

# Default model id
# aliases: LLM_MODEL
SERM_LLM_MODEL=anthropic/claude-sonnet-5.5

# LLM request timeout, seconds
LLM_TIMEOUT=120

# Retries on 429/5xx/timeouts
LLM_MAX_RETRIES=3

# Price per 1M input tokens, provider billing currency
LLM_PRICE_INPUT_PER_MTOK=

# Price per 1M output tokens, provider billing currency
LLM_PRICE_OUTPUT_PER_MTOK=

# Budget per generation run in the provider billing currency (Polza: RUB, many others: USD); empty or none = no limit. Works only if the provider returns usage.cost or LLM_PRICE_* are set
LLM_MAX_COST_PER_RUN=300

# Admin panel token; empty = generated on first start
# aliases: ADMIN_PASSWORD
ADMIN_TOKEN=

# Telegram user id that receives system alerts
# aliases: TELEGRAM_ADMIN_ID
ADMIN_TG_ID=

# Admin panel port
ADMIN_PORT=8180

# Admin panel bind address (0.0.0.0 = all interfaces; Docker sets it)
ADMIN_HOST=127.0.0.1

# true/false overrides the autopilot state file
AUTOPILOT_ENABLED=

# Profile name or path to profiles/<name>.yaml
SERM_PROFILE=

# Data directory (db, sessions, exports)
SERM_DATA_DIR=

# sync-sessions: user@host of the server
SERM_DEPLOY_HOST=

# sync-sessions: path to the SSH key
SERM_DEPLOY_KEY=

# sync-sessions: install directory on the server
SERM_DEPLOY_DIR=
